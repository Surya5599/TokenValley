# dependencies / build
node_modules/
dist/
*.tsbuildinfo
.vite/

# your companies stay private; the README and example are shared
companies/*
!companies/README.md
!companies/_example/
companies/_example/status.md

# runtime state: never commit project workspaces, databases, or logs
workspaces/*
!workspaces/.gitkeep
data/*
!data/.gitkeep
*.sqlite
*.sqlite-journal
*.db
logs/

# local config and secrets
.env
.env.*
!.env.example
tokenvalley.local.json
.claude/settings.local.json
.mcp.local.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code session state
.claude/scheduled_tasks.lock

# recorded videos
exports/
