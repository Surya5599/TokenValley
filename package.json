{
  "name": "tokenvalley",
  "private": true,
  "version": "0.1.0",
  "description": "A low-poly 3D valley of AI companies, staffed by real Claude Code agents, that build your projects while you watch. The Office: Agent Edition.",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:server": "pnpm --filter @tokenvalley/server dev",
    "dev:client": "pnpm --filter @tokenvalley/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "spike": "pnpm --filter @tokenvalley/server spike"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
